# Copy this file to .env and fill in. Never commit .env. Never print these values.

# --- PRIMARY provider: WaveSpeedAI (one key, all models) ---
WAVESPEED_API_KEY=
WAVESPEED_BASE_URL=https://api.wavespeed.ai/api/v3

# --- SECONDARY provider: BytePlus ModelArk (add later, cheaper finals) ---
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_VIDEO_MODEL=
ARK_IMAGE_MODEL=

# --- LLM: pipeline agents + the "Trợ lý AI" chat panel (docs/BRIEF.md 8.1) ---
# Fill at least one. API keys are pay-per-use, separate from a Claude Pro or ChatGPT Plus plan.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: one key that reaches Claude, GPT, Gemini and others
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Budget guards (USD) ---
BUDGET_PER_EPISODE=40
BUDGET_PER_MONTH=190
BUDGET_M0_TEST=5
